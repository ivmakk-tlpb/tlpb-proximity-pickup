<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build settings and the common game references live in Directory.Build.props at the repo root.
       This file names the plugin and adds the assemblies that only this mod uses. -->
  <PropertyGroup>
    <AssemblyName>ProximityPickup</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The item labels (UI, TextMeshPro) and the radius search (physics). -->
  <ItemGroup>
    <_Ref Include="$(BepInExInterop)\UnityEngine.UI.dll" />
    <_Ref Include="$(BepInExInterop)\UnityEngine.UIModule.dll" />
    <_Ref Include="$(BepInExInterop)\Unity.TextMeshPro.dll" />
    <_Ref Include="$(BepInExInterop)\UnityEngine.PhysicsModule.dll" />
    <Reference Include="@(_Ref)">
      <HintPath>%(FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
